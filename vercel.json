{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "ignoreCommand": "node scripts/production-schema.mjs --ignore-unapproved",
  "buildCommand": "node scripts/production-schema.mjs && npm run build",
  "installCommand": "npm ci",
  "regions": ["icn1"],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "codex/dev-a-p0-continue": false
    }
  }
}
