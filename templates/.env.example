# Copy this template to .env.local and populate yourself; NEVER commit actual secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, avoid unless needed in secured admin operations
SUPABASE_SERVICE_ROLE_KEY=
# SDK v2 one-time checkout (TEST keys only)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Optional AI — leave blank to use deterministic matcher
AI_PROVIDER=
AI_API_KEY=
# Test-only accounts supplied via separate .env.test.local, not committed
