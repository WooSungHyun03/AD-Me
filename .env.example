NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Toss "API 개별 연동" TEST key set: test_ck_ here, test_sk_ in Edge Function secrets (widget test_gck_/test_gsk_ keys do not work with payment()).
NEXT_PUBLIC_TOSS_CLIENT_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# TOSS_SECRET_KEY is set in Supabase Edge Function secrets, never NEXT_PUBLIC_.
# Server-only. free_beta (default, real free service) | test_demo (separate TEST demo env with fixtures + Toss TEST).
SERVICE_MODE=free_beta
# Server-only YouTube Data API v3 key (D019). Ingestion stays blocked until docs/data-sources policy is approved.
YOUTUBE_API_KEY=
# Server-only (D027 private uploads + cleanup). Never NEXT_PUBLIC_; uploads return 503 when unset.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only (D086). Slack/Discord-compatible incoming webhook for error / health / free-limit alerts. Optional.
ALERT_WEBHOOK_URL=
