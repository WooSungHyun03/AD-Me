NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADME_SERVICE_MODE=free_beta
ADME_FEATURE_MAIL=off
ADME_FEATURE_TEST_BILLING=off
ADME_FEATURE_INGESTION=off
ADME_FEATURE_LLM=off
# On isolated TEST only, mirror the billing flag and mode in Edge Function secrets.
# TOSS_SECRET_KEY belongs exclusively in the TEST Supabase Edge Function secrets.
# Optional server-only Vercel credential for verified image storage and hashed request budgets.
# USER registers it; never use NEXT_PUBLIC_ for a service credential.
SUPABASE_SERVICE_ROLE_KEY=

# DEV-B integration configuration names
# Legacy SERVICE_MODE is optional. Prefer ADME_SERVICE_MODE above; conflicting or invalid modes fail closed.
YOUTUBE_API_KEY=
ALERT_WEBHOOK_URL=
